@{
    ViewData["Title"] = "Geliştirdiğim Yazılımlar";
}

<!-- Header Banner -->
<div class="bg-white py-5 border-bottom mb-5">
    <div class="container text-center">
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-3 fw-semibold">💻 Sistem & Uygulama Projeleri</span>
        <h1 class="display-5 fw-extrabold text-dark mb-3">Geliştirdiğim Yazılımlar</h1>
        <p class="text-secondary mx-auto mb-0" style="max-width: 600px;">
            Low-level sistem programlamadan masaüstü araçlarına, özel kernel mimarilerinden konsol uygulamalarına kadar geliştirdiğim projeler.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">

        <!-- Proje 1: Kurucuk OS -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column justify-content-between p-4">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-dark rounded-pill px-3 py-2">Assembly & C</span>
                        <small class="text-muted"><i class="bi bi-cpu me-1"></i>x86 Kernel</small>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Kurucuk OS</h4>
                    <p class="text-secondary small mb-3">
                        16-bit x86 real-mode üzerinde çalışan, özel bootloader, ekran düzeni ve klavye girdisi yönetimi barındıran custom kernel projesi.
                    </p>
                </div>
                <div class="pt-3 border-top mt-3 d-flex align-items-center justify-content-between">
                    <span class="badge bg-light text-dark border">QEMU Test</span>
                    <a href="/Software/kurucuk-os" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                        İncele <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Proje 2: Aslan OS -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column justify-content-between p-4">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-primary rounded-pill px-3 py-2">N Tier Architecture & C#</span>
                        <small class="text-muted"><i class="bi bi-terminal me-1"></i>Console OS</small>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Dev Pomodoro</h4>
                    <p class="text-secondary small mb-3">
                        Dev Pomodoro Çalışmanızı en verimli yapmayı sağlayan bir zaman aracıdır.
                    </p>
                </div>
                <div class="pt-3 border-top mt-3 d-flex align-items-center justify-content-between">
                    <span class="badge bg-light text-dark border">Software App</span>
                    <a href="/Software/dev-pomodoro-app" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                        İncele <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Proje 3: MatKalem -->
        <div class="col-lg-4 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column justify-content-between p-4">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-success rounded-pill px-3 py-2">C# WinForms</span>
                        <small class="text-muted"><i class="bi bi-window me-1"></i>Desktop Tool</small>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">MatKalem</h4>
                    <p class="text-secondary small mb-3">
                        Masaüstü üzerinde hızlı çizim, not alma ve görsel anlatım süreçleri için tasarlanmış serverless C# Windows Forms uygulaması.
                    </p>
                </div>
                <div class="pt-3 border-top mt-3 d-flex align-items-center justify-content-between">
                    <span class="badge bg-light text-dark border">Desktop App</span>
                    <a href="/Software/Detail/matkalem" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                        İncele <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>