@{
    ViewData["Title"] = "Hakkımda";
}

<div class="container py-5" style="max-width: 950px;">
    <!-- Üst Başlık Kartı -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-3 text-center">
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 130px; height: 130px;">
                    <i class="bi bi-code-slash display-4"></i>
                </div>
            </div>
            <div class="col-md-9 text-center text-md-start">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Yazılım & Teknoloji Blogu</span>
                <h1 class="fw-bold text-dark mb-2">Developer Ahmet</h1>
                <p class="text-muted fs-5 mb-3">Backend & System Developer</p>
                <div class="d-flex gap-2 justify-content-center justify-content-md-start">
                    <a href="https://github.com/ahmetcoder55" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="bi bi-github me-1"></i> GitHub
                    </a>
                    <a href="#" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-linkedin me-1"></i> LinkedIn
                    </a>
                    <a href="https://www.youtube.com/@@developerahmet" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-youtube me-1"></i> Youtube
                    </a>
                    <a href="#" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-envelope me-1"></i> E-Posta
                    </a>
                    <a href="https://ahmetcoder55.github.io/static-blog/index.html" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">Web Sitesi</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Detay Kartları -->
    <div class="row g-4">
        <!-- Ben Kimim? -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-person-badge me-2"></i>Ben Kimim?
                </h5>
                <p class="text-secondary lh-lg mb-0">
                    Merhaba! Ben Ahmet. Modern web teknolojileri, backend mimarileri ve C# / .NET dünyası üzerine projeler geliştiriyorum. Bu blog platformunda öğrendiğim güncel yazılım konseptlerini, Clean Architecture uygulamalarını ve teknik deneyimlerimi paylaşıyorum.
                </p>
            </div>
        </div>

        <!-- Odak Alanları -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-cpu me-2"></i>Teknoloji & Uzmanlık
                </h5>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">C# / .NET 10</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">ASP.NET Core MVC</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">Entity Framework Core</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">MSSQL / PostgreSQL</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">Clean Architecture</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-3">Bootstrap 5</span>
                </div>
            </div>
        </div>
    </div>
</div>