@using DevBlog.Business.DTOs

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    var recentArticles = ViewBag.RecentArticles as List<ArticleDto> ?? new List<ArticleDto>();
}

<!-- İstatistik Kartları -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-stat bg-white shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">TOPLAM MAKALE</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalArticles</h2>
                </div>
                <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center fs-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-stat bg-white shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">KATEGORİ SAYISI</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@ViewBag.TotalCategories</h2>
                </div>
                <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center fs-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-folder-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-stat bg-white shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">SİSTEM DURUMU</span>
                    <h2 class="fw-bold text-success mt-2 mb-0">Aktif</h2>
                </div>
                <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center fs-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-cpu"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hızlı Aksiyonlar ve Son Makaleler -->
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Son Eklenen Makaleler</h5>
                <a href="/Admin/Article/Create" class="btn btn-primary rounded-3 px-3 py-1 fw-semibold btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Makale
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th>Yayın Tarihi</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentArticles.Any())
                        {
                            @foreach (var article in recentArticles)
                            {
                                <tr>
                                    <td class="fw-semibold">@article.Title</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary">@article.CategoryName</span></td>
                                    <td>@article.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a href="/Admin/Article/Edit/@article.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Henüz kaydedilmiş makale yok.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>