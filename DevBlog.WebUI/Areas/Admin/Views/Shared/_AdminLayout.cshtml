<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevBlog Admin</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --font-main: 'Plus Jakarta Sans', sans-serif;
                --sidebar-width: 260px;
            }

            body {
                font-family: var(--font-main);
                background-color: #f1f5f9;
            }

            .admin-sidebar {
                width: var(--sidebar-width);
                min-height: 100vh;
                background-color: #0f172a;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1000;
            }

            .admin-main {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .nav-link-admin {
                color: #94a3b8;
                border-radius: 0.5rem;
                padding: 0.75rem 1rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                transition: all 0.2s ease;
            }

                .nav-link-admin:hover, .nav-link-admin.active {
                    color: #ffffff;
                    background-color: rgba(255, 255, 255, 0.1);
                }

            .card-stat {
                border: none;
                border-radius: 1rem;
                transition: transform 0.2s ease;
            }

                .card-stat:hover {
                    transform: translateY(-3px);
                }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar p-3 d-flex flex-column">
        <a href="/Admin" class="fs-4 fw-bold text-white text-decoration-none px-2 mb-4 d-block">
            DevBlog<span class="text-primary">.Admin</span>
        </a>

        <ul class="nav flex-column gap-1 mb-auto">
            <li class="nav-item">
                <a href="/Admin/Home" class="nav-link-admin active">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a href="/Admin/Article" class="nav-link-admin">
                    <i class="bi bi-journal-richtext"></i> Makaleler
                </a>
            </li>
            <li class="nav-item">
                <a href="/Admin/Category" class="nav-link-admin">
                    <i class="bi bi-folder-fill"></i> Kategoriler
                </a>
            </li>
            <li class="nav-item">
                <a href="/" target="_blank" class="nav-link-admin mt-3 border-top border-secondary pt-3">
                    <i class="bi bi-box-arrow-up-right"></i> Siteye Git
                </a>
            </li>
        </ul>

        <div class="pt-3 border-top border-secondary">
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100 rounded-3 text-start d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-left"></i> Çıkış Yap
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="admin-main">
        <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center sticky-top shadow-sm">
            <h5 class="fw-bold mb-0">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-shield-check me-1"></i> Admin Oturumu
                </span>
            </div>
        </header>

        <main class="p-4 flex-grow-1">
            @RenderBody()
        </main>

        <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
            &copy; 2026 Developer Ahmet
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>