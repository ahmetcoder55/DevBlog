@using DevBlog.Business.DTOs
@model CategoryUpdateDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 600px;">
    <h5 class="fw-bold mb-4">Kategori Düzenle</h5>

    <form asp-area="Admin" asp-controller="Category" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold">Kategori Adı</label>
            <input asp-for="Name" class="form-control rounded-3" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                <i class="bi bi-check-lg me-1"></i> Güncelle
            </button>
            <a href="/Admin/Category" class="btn btn-outline-secondary rounded-3 px-4">İptal</a>
        </div>
    </form>
</div>