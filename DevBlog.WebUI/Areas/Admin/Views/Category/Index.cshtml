@using DevBlog.Business.DTOs
@model IEnumerable<CategoryDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategoriler";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1">Kategori Yönetimi</h5>
            <p class="text-muted small mb-0">Sistemdeki kategorileri düzenleyin veya yeni kategori ekleyin</p>
        </div>
        <a href="/Admin/Category/Create" class="btn btn-primary rounded-3 px-4 fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Yeni Kategori
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Kategori Adı</th>
                    <th>Açıklama</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-muted">#@cat.Id</td>
                            <td class="fw-bold text-dark">@cat.Name</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(cat.Description) ? "-" : cat.Description)</td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a href="/Admin/Category/Edit/@cat.Id" class="btn btn-sm btn-outline-primary rounded-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/Admin/Category/Delete/@cat.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bu makaleyi silmek istediğinize emin misiniz?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-2">
                                            <i class="bi bi-trash me-1"></i> Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Kategori bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>